# Caddy reverse proxy. Set the domain variables in .env before production use.

{
    email {$CADDY_EMAIL}
}

{$API_DOMAIN} {
    reverse_proxy backend:8000
}

{$APP_DOMAIN} {
    reverse_proxy dashboard:3000
}

# Keep this hostname private or protect it with an identity-aware proxy.
{$N8N_DOMAIN} {
    reverse_proxy n8n:5678
}
