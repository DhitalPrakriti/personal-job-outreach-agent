# ============================================================
# AI Email Automation Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ─── App ───────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-string
API_BASE_URL=http://localhost:8000

# ─── Database ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ─── Qdrant (Vector DB) ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# ─── LLM (via LiteLLM) ────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-ant-xxxxx
LITELLM_MASTER_KEY=sk-litellm-xxxxx

# Model config
PRIMARY_MODEL=claude-sonnet-4-20250514
FAST_MODEL=claude-3-5-haiku-20241022
MONTHLY_LLM_BUDGET_USD=200

# ─── Email Sending (Amazon SES) ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SENDER_EMAIL=outreach@yourdomain.com
SES_CONFIGURATION_SET=email-agent-tracking

# ─── Email Receiving (IMAP) ───────────────────────────────
IMAP_HOST=imap.yourdomain.com
IMAP_PORT=993
IMAP_USER=replies@yourdomain.com
IMAP_PASSWORD=change-me

# ─── Email Validation (NeverBounce) ───────────────────────
NEVERBOUNCE_API_KEY=

# ─── Domain Warm-Up (Instantly.ai) ────────────────────────
INSTANTLY_API_KEY=

# ─── n8n ───────────────────────────────────────────────────
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_WEBHOOK_URL=http://localhost:5678

# ─── Dify ─────────────────────────────────────────────────
DIFY_PORT=3100
DIFY_API_KEY=app-xxxxx
DIFY_BASE_URL=http://localhost:3100/v1

# ─── Dashboard ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
DASHBOARD_PORT=3000

# ─── Notifications (Slack) ─────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_HOT_LEAD_CHANNEL=#hot-leads

# ─── Monitoring ────────────────────────────────────────────
SENTRY_DSN=
BETTERUPTIME_API_KEY=

# ─── Backups (Backblaze B2) ────────────────────────────────
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=email-agent-backups

# ─── Notion (Lead Source) ─────────────────────────────────
NOTION_API_KEY=secret_xxxxx
NOTION_LEADS_DATABASE_ID=
