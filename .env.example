# Personal AI Outreach Agent - example configuration
# Copy to .env, replace placeholders, and never commit .env.

# Application
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-random-secret
API_BASE_URL=http://localhost:8000
AUTOMATION_API_KEY=replace-with-a-random-automation-token

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://agent:change-me@localhost:5432/email_agent

# Redis and Qdrant
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# AI through LiteLLM
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-change-me
ANTHROPIC_API_KEY=
PRIMARY_MODEL=claude-sonnet
FAST_MODEL=claude-haiku
MONTHLY_LLM_BUDGET_USD=200
AI_DRAFTING_ENABLED=false

# Job discovery
# Remotive and RemoteOK work without keys. Adzuna is optional and improves Canada job coverage.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Optional Notion contact source and writeback
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=
NOTION_LEADS_DATA_SOURCE_ID=
NOTION_WRITEBACK_ENABLED=false
NOTION_OUTREACH_STATUS_PROPERTY_NAME=Outreach Status
NOTION_NOTES_PROPERTY_NAME=notes
NOTION_VERSION=2026-03-11

# Email provider
EMAIL_PROVIDER=gmail
EMAIL_SENDING_ENABLED=false
EMAIL_REPLY_SYNC_ENABLED=false
EMAIL_REPLY_LOOKBACK_HOURS=72
EMAIL_REPLY_MAX_MESSAGES=50

# Google / Gmail OAuth
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
GOOGLE_INBOX_EMAIL=
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft Graph / Outlook, optional fallback provider
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_USER=
MICROSOFT_INBOX_USER=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com

# Dashboard
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional notifications and Dify integration
SLACK_WEBHOOK_URL=
DIFY_BASE_URL=http://localhost:3100/v1
DIFY_API_KEY=
