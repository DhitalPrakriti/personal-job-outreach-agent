        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{\"days_since_sent\":3,\"limit\":25}",
        "options": {}
      },
      "id": "generate-followups-04-request",
      "name": "Call Email Automation API",
